[general]
# Default model: provider/model-id
model = "zai/glm-4.7"
# Optional model-specific reasoning level, e.g. low/high/max for zai/glm-5.3.
# A project config can set "default" to clear an inherited user value.
# reasoning = "high"
# User-scoped TUI theme. Authored: carbon (default), parchment, frost,
# high-contrast, and terminal (adapts to your own terminal colours, and so
# has no surfaces of its own). Ported: monokai, dracula, gruvbox-dark,
# gruvbox-light, solarized-dark, solarized-light, tokyo-night,
# catppuccin-mocha, one-dark, rose-pine.
theme = "carbon"
# Whether the working directory's AGENTS.md/CLAUDE.md joins the system
# prompt. A project file is unauthenticated third-party input; set this
# to false to distrust it by default and opt a directory in per launch
# with --project-instructions, or leave it on and pass
# --no-project-instructions for a single launch. User-scoped: a
# project's own config cannot set it.
# project_instructions = true

[providers.openai]
# api_key from ILAR_OPENAI_API_KEY (env) by default; can be set here.
# base_url = "https://api.openai.com/v1"
#
# ChatGPT-account OAuth instead of an API key (Codex-style): run
#   ilar login
# then set:
#   auth = "chatgpt"
# A project override can switch back with auth = "api_key".
# Models are the -codex/ChatGPT ones (e.g. gpt-5.6-sol), not the API
# catalog names. Tokens live in <state dir>/auth.json and refresh
# automatically.

[providers.zai]
# OpenAI-compatible coding-plan endpoint (default):
#   base_url = "https://api.z.ai/api/coding/paas/v4"
# api_key from ILAR_ZAI_API_KEY (env).

# Your own OpenAI-compatible endpoint (llama.cpp, ollama, vLLM, a
# gateway...). Each section is one model, reachable as custom/<name>.
# Required: base_url and context. Everything else is optional.
#
# [models.qwen]
# # Everything up to /chat/completions.
# base_url = "http://127.0.0.1:8080/v1"
# # The window the server actually serves: this is what the context meter
# # and compaction measure against, since no catalog row knows it.
# context = 32768
# # Reply budget carved out of context; a quarter of it by default.
# output = 8192
# # Wire id, when the server calls the model something else. Defaults to
# # the section name (ollama, for instance, wants "llama3.3:70b").
# model = "qwen3-coder"
# # Omit for a local server: with no key, no Authorization header is sent
# # at all. There is no env-var fallback for these entries.
# api_key = "sk-local"
# vision = false
# display_name = "Qwen3 Coder (local)"
# # Extra body fields, merged into every request as typed. The wire owns
# # model/messages/tools/stream/stream_options; naming one here is an
# # error at startup.
# options = { temperature = 0.7, top_p = 0.9, min_p = 0.05 }

[agent]
# Max provider calls per user turn — a runaway-loop backstop, not a
# working limit. Long-thinking models need hundreds on big tasks.
# max_iterations = 1000

[compaction]
# Summarize when transcript exceeds this fraction of context window.
threshold = 0.85

[subagents]
max_concurrent = 10
max_depth = 3
# Background bash/tool timeout in milliseconds.
background_tool_timeout_ms = 600000

# Custom agents live in ~/.config/ilar/agents/*.md or .ilar/agents/*.md.
# See examples/agents/explorer.md for supported frontmatter.
